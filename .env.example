# --- Núcleo ---
DATABASE_URL=postgresql://usuario:clave@host:5432/legado_verde   # local: sqlite:///./legado_verde.db
APP_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio
MCP_TOKEN=otro-token-largo-para-el-conector-de-claude   # si lo dejas vacío se usa APP_TOKEN
BASE_URL=https://tu-app.onrender.com
TZ_NEGOCIO=America/Mexico_City

# --- IA ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5          # en el coche puedes probar claude-haiku-5-5 para menor latencia
OPENAI_API_KEY=                          # opcional: transcripción de respaldo si el navegador no soporta Web Speech
STT_MODEL=whisper-1

# --- Supuestos financieros (ESTIMADOS) ---
COSTO_VARIABLE_UNITARIO=24.07
COSTOS_FIJOS_MENSUALES=29383.33

# --- Mercado Libre ---
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# --- Amazon SP-API ---
AMZ_LWA_CLIENT_ID=
AMZ_LWA_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_MARKETPLACE_ID=A1AM78C64UM0Y8
AMZ_SQS_QUEUE_URL=                       # opcional (notificaciones ORDER_CHANGE)

# --- Sincronización desatendida ---
SYNC_HABILITADO=true
SYNC_MINUTOS=15
