# Copia este archivo como .env en el SERVIDOR (nunca lo subas al repositorio).

# Almacenamiento persistente (ruta en un disco que sobreviva reinicios)
LEGADO_VERDE_DB=/var/lib/legado-verde/legado_verde.sqlite3
LEGADO_VERDE_INTEG_DB=/var/lib/legado-verde/integraciones.sqlite3

# Mercado Libre (aplicación creada en developers.mercadolibre.com.mx)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_SELLER_ID=
ML_REDIRECT_URI=https://tu-dominio/callback-ml
# Solo si ya tienes uno; después el sistema guarda el token rotado en la base de integraciones.
ML_REFRESH_TOKEN=

# Amazon Selling Partner API (aplicación privada en Seller Central)
AMZ_LWA_CLIENT_ID=
AMZ_LWA_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_SELLER_ID=
AMZ_MARKETPLACE_ID=A1AM78C64UM0Y8
AMZ_ENDPOINT=https://sellingpartnerapi-na.amazon.com
